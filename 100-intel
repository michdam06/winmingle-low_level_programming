# Description: # A script that generates the assembly code (Intel syntax) of a C code file
# Compile the C file into assembly code using GCC with Intel syntax.
# $CFILE is an environment variable containing the name of the C source file
#1/bin/bash
gcc -S -masm=intel "$CFILE" -o "${CFILE%.c}.s"
